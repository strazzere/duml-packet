{
	"compilerOptions": {
		"module": "ES2022",
		"esModuleInterop": true,
		"target": "es2022",
		// TypeScript 6 turns strict on by default, which this code base doesn't satisfy yet
		"strict": false,
		"noImplicitAny": true,
		"sourceMap": true,
		"moduleResolution": "bundler",
		"rootDir": "src",
		"outDir": "dist",
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"resolveJsonModule": true,
		"declaration": true,
		"types": ["node", "jest"],
		"skipLibCheck": true
	},
	"include": ["src/**/*"],
	"exclude": [
		"src/**/*.spec.ts",
		"node_modules",
		"dist",
		"./node_modules",
		"./node_modules/**/*",
		"./node_modules/@types/node/index.d.ts"
	]
}
